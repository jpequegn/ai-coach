# AI Coach API - Environment Variables Configuration
# Copy this file to .env and configure for your environment

# ============================================================================
# Required Configuration
# ============================================================================

# JWT Secret Key (REQUIRED in production)
# Must be at least 32 characters for security
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long

# Database URL (REQUIRED)
# SQLite (default for MVP): sqlite://ai-coach-api/data/ai-coach.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/ai_coach
DATABASE_URL=sqlite://ai-coach-api/data/ai-coach.db

# ============================================================================
# Server Configuration
# ============================================================================

# Server host and port
HOST=0.0.0.0
PORT=3000

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (error, warn, info, debug, trace)
LOG_LEVEL=info

# ============================================================================
# Security - CORS Configuration
# ============================================================================

# Allowed origins for CORS (comma-separated)
# Production MUST explicitly set this
# Development defaults: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ============================================================================
# Database Connection Pool
# ============================================================================

# Maximum number of database connections
DB_MAX_CONNECTIONS=20

# Minimum number of database connections
DB_MIN_CONNECTIONS=5

# Connection timeout in seconds
DB_CONNECT_TIMEOUT=30

# Idle connection timeout in seconds
DB_IDLE_TIMEOUT=600

# ============================================================================
# Optional Integrations
# ============================================================================

# Oura Ring OAuth Configuration (optional)
# OURA_CLIENT_ID=your-oura-client-id
# OURA_CLIENT_SECRET=your-oura-client-secret
# OURA_REDIRECT_URI=http://localhost:3000/api/v1/wearable/oura/callback

# ============================================================================
# Production Deployment Notes
# ============================================================================

# REQUIRED for production:
# 1. JWT_SECRET - Use strong random value (openssl rand -base64 32)
# 2. DATABASE_URL - Use PostgreSQL for production
# 3. ALLOWED_ORIGINS - Set explicitly to your frontend URL(s)
# 4. ENVIRONMENT=production

# Example production configuration:
# JWT_SECRET=abc123...xyz789 (32+ characters)
# DATABASE_URL=postgresql://aicoach:securepass@db.example.com:5432/ai_coach
# ALLOWED_ORIGINS=https://app.aicoach.example.com
# ENVIRONMENT=production
# LOG_LEVEL=warn
