  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                job_name,\n                started_at,\n                completed_at,\n                status as \"status: JobExecutionStatus\",\n                records_processed,\n                records_failed,\n                error_message,\n                execution_time_ms,\n                metadata,\n                created_at,\n                updated_at\n            FROM job_execution_log\n            WHERE job_name = $1\n            ORDER BY started_at DESC\n            LIMIT 1\n            ",
