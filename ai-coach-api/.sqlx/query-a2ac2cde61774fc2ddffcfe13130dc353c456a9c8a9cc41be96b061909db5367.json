  "query": "\n                SELECT id, user_id, alert_type, severity, recovery_score_id,\n                       message, recommendations, acknowledged_at, created_at\n                FROM recovery_alerts\n                WHERE user_id = $1 AND acknowledged_at IS NULL\n                ORDER BY created_at DESC\n                LIMIT $2\n                ",
