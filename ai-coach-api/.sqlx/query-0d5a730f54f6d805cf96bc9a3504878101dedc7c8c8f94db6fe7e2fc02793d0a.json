{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT ON (m.user_id)\n            m.user_id,\n            u.email,\n            m.completeness_score,\n            m.days_without_data,\n            m.last_data_timestamp,\n            m.data_sources\n        FROM data_quality_metrics m\n        JOIN users u ON m.user_id = u.id\n        WHERE m.completeness_score < $1\n        ORDER BY m.user_id, m.metric_date DESC\n        LIMIT $2 OFFSET $3\n        ",
